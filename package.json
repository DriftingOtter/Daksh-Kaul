{
  "name": "aboutme",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "jekyll": "./scripts/jekyll build",
    "build": "bun build ./index.ts --outfile=./bundle.js --target=browser && bun run jekyll",
